<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8">
    <title>Galeriipiltide üleslaadimine</title>
</head>
<body>

    <h1>Galeriipiltide üleslaadimine</h1>

   
    <br>
    <a href="/galleryPhotoUpload/gallery">Vaata galeriid</a>
	<br>
	<a href="/home">Tagasi avalehele</a>
	<li><a href="/logout">Logi välja</a></li>
    <hr>

    <form method="POST" enctype="multipart/form-data">

        <label for="photoInput">Vali pilt</label>
        <input id="photoInput" name="photoInput" type="file">

        <br><br>

        <label for="altInput">Alternatiivtekst</label>
        <input id="altInput" name="altInput" type="text">

        <br><br>

        <input id="privacyInput1" name="privacyInput" type="radio" value="1" checked>
        <label for="privacyInput1">Privaatne</label>

        <br>

        <input id="privacyInput2" name="privacyInput" type="radio" value="2">
        <label for="privacyInput2">Sisseloginud kasutajatele</label>

        <br>

        <input id="privacyInput3" name="privacyInput" type="radio" value="3">
        <label for="privacyInput3">Avalik</label>

        <br><br>

        <input type="submit" value="Lae üles">

    </form>

</body>
</html>