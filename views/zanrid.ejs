<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Žanri lisamine</title>
</head>
<body>
	<h1>Lisa filmide žanr</h1>
	<p><%= notice %></p>
	
	<form method="POST" action="/eestifilm/zanrid_add">
		<label>Žanri nimi:</label>
		<input type="text" name="genreNameValue" value="<%= genreNameValue ? genreNameValue : '' %>">
		<br>
		<label>Kirjeldus:</label>
		<input type="text" name="descriptionValue" value="<%= descriptionValue ? descriptionValue : '' %>">
		<br>
		<button type="submit">Salvesta žanr</button>
	</form>

	<p><a href="/">Tagasi avalehele</a></p>
</body>
</html>